# Keep the build context small; the target dir and VCS metadata must never
# reach the builder. `.sqlx/` and `Cargo.lock` are REQUIRED in the context
# (offline, --locked build), so they are deliberately NOT ignored.
.env
.env.*
!.env.example
*.orig
*.rej
.codegraph/
.git/
.omo/
.opencode/
__pycache__/
# NOTE: only the fuzz build outputs are excluded. The fuzz sources
# (`Cargo.toml`, `rust-toolchain.toml`, `fuzz_targets/`, `corpus/`) MUST stay
# in the context: `.clusterfuzzlite/Dockerfile` builds from this same context
# and needs them.
fuzz/target/
fuzz/build/
fuzz/artifacts/
scripts/__pycache__/
target/
# NOTE: `build.sh` MUST stay in the context: `.clusterfuzzlite/Dockerfile`
# copies it (`COPY .clusterfuzzlite/build.sh`) from this same context.
.clusterfuzzlite/*
!.clusterfuzzlite/build.sh
lcov.info
*.sarif
